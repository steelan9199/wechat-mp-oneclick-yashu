{
  "_comment": "每个 action 就是一个设置项。加新选项只需往 actions 数组里追加一段，不需要改任何 JS 代码。target 可以是字符串，也可以是字符串数组（按顺序尝试候选选择器）。",
  "_valueHint": "步骤里的 {{key}} 会被弹窗中同名输入框的值替换。",
  "actions": [
    {
      "id": "original",
      "name": "原创声明",
      "desc": "点击未声明 → 确定",
      "steps": [
        {
          "action": "click",
          "desc": "点击「未声明」",
          "target": "#js_original > div:nth-child(1) > div.setting-group__switch.js_original_apply.js_edit_ori > div"
        },
        {
          "action": "waitFor",
          "desc": "等待原创弹框就绪",
          "target": [
            "#js_original_edit_box input.js_author",
            "span.js_customerauthor_container > input.js_author"
          ],
          "timeout": 8000
        },
        {
          "action": "click",
          "desc": "点击「确定」",
          "pick": "last",
          "target": [
            "#vue_app > mp-image-product-dialog > div > div.weui-desktop-dialog__wrp > div > div.weui-desktop-dialog__ft > div > div:nth-child(2) > button",
            "button.weui-desktop-btn.weui-desktop-btn_primary"
          ],
          "text": "确定"
        }
      ],
      "verify": {
        "action": "gone",
        "target": [
          "span.js_customerauthor_container > input.js_author",
          "#js_original_edit_box input.js_author"
        ],
        "timeout": 6000
      }
    },
    {
      "id": "reward",
      "name": "赞赏",
      "desc": "点「不开启」→ 同意协议 → 确定，成功后显示「账户: xxx」",
      "steps": [
        {
          "action": "click",
          "desc": "点击赞赏开关（不开启）",
          "target": [
            "#js_reward_setting_area > div > div.setting-group__switch.js_reward_open > span",
            "#js_reward_setting_area .js_reward_open span.js_reward_setting_tips"
          ],
          "wait": 1000
        },
        {
          "action": "waitFor",
          "desc": "等待赞赏设置弹框",
          "target": [
            ".reward-setting-dialog__footer",
            ".agreement-check-btn__wrp"
          ],
          "timeout": 8000
        },
        {
          "action": "toggle",
          "desc": "勾选《赞赏功能使用协议》",
          "target": [
            ".agreement-check-btn__wrp input.weui-desktop-form__checkbox",
            "#vue_app mp-image-product-dialog input.weui-desktop-form__checkbox"
          ],
          "checked": true,
          "visibleOnly": false,
          "optional": true,
          "wait": 300
        },
        {
          "action": "click",
          "desc": "点击「确定」",
          "pick": "last",
          "target": [
            "#vue_app > mp-image-product-dialog > div > div.weui-desktop-dialog__wrp > div > div.weui-desktop-dialog__ft > div > div.operate-btn__group > div:nth-child(1) > button",
            ".reward-setting-dialog__footer .operate-btn__group button.weui-desktop-btn_primary",
            "button.weui-desktop-btn.weui-desktop-btn_primary"
          ],
          "text": "确定",
          "wait": 1000
        }
      ],
      "verify": {
        "action": "text",
        "value": "账户",
        "target": [
          "#js_reward_setting_area span.js_reward_setting_tips",
          "#js_reward_setting_area .js_reward_open .js_reward_setting_tips"
        ],
        "timeout": 8000
      }
    },
    {
      "id": "comment",
      "name": "留言",
      "desc": "点「不开启留言」→ 等 1 秒 → 点「确定」，成功后该行显示「已开启」",
      "steps": [
        {
          "action": "click",
          "desc": "点击「不开启留言」",
          "target": [
            "#js_comment_setting_area > div > div.setting-group__switch > span",
            "#js_comment_setting_area .js_comment_setting_tips",
            "#js_comment_setting_area span.setting-group__switch-tips",
            ".js_comment_open span",
            ".js_comment_setting span.setting-group__switch-tips"
          ],
          "text": "不开启留言",
          "climb": true,
          "wait": 1000
        },
        {
          "action": "waitFor",
          "desc": "等待留言设置弹框",
          "target": [
            "mp-image-product-dialog .weui-desktop-dialog__ft button.weui-desktop-btn_primary",
            ".weui-desktop-dialog__ft button.weui-desktop-btn_primary"
          ],
          "text": "确定",
          "pick": "last",
          "timeout": 8000
        },
        {
          "action": "click",
          "desc": "点击「确定」",
          "target": [
            "mp-image-product-dialog .weui-desktop-dialog__ft button.weui-desktop-btn_primary",
            ".weui-desktop-dialog__ft button.weui-desktop-btn_primary",
            "button.weui-desktop-btn.weui-desktop-btn_primary"
          ],
          "text": "确定",
          "pick": "last",
          "wait": 1000
        }
      ],
      "verify": {
        "action": "gone",
        "target": [
          "mp-image-product-dialog .weui-desktop-dialog__ft button.weui-desktop-btn_primary",
          ".weui-desktop-dialog__ft button.weui-desktop-btn_primary"
        ],
        "text": "确定",
        "pick": "last",
        "timeout": 6000
      }
    },
    {
      "id": "claim_source",
      "name": "创作来源",
      "desc": "点「未添加」→ 选「内容由AI生成」→ 确认，成功后该行显示「内容由AI生成」",
      "steps": [
        {
          "action": "click",
          "desc": "点击「创作来源」行的「未添加」",
          "text": "未添加",
          "textScan": false,
          "climb": true,
          "wait": 1000,
          "target": [
            "#js_claim_source_area > label > div.allow_click_opr.js_claim_source_desc > span.lbl_content_desc_default",
            "#js_claim_source_area .js_claim_source_desc span.lbl_content_desc_default",
            "#js_claim_source_area .js_claim_source_desc span.lbl_content_desc"
          ]
        },
        {
          "action": "waitFor",
          "desc": "等待创作来源弹框",
          "timeout": 8000,
          "target": [
            "div.claim-source-dialog .weui-desktop-dialog__ft",
            "div.claim-source-dialog"
          ]
        },
        {
          "action": "click",
          "desc": "选择「内容由AI生成」",
          "text": "内容由AI生成",
          "wait": 600,
          "target": [
            "div.claim-source-dialog .weui-desktop-form__check-content",
            "div.claim-source-dialog .weui-desktop-form__check-label > span",
            "#vue_app > mp-image-product-dialog > div.claim-source-dialog .weui-desktop-dialog__bd .weui-desktop-form__check-content"
          ]
        },
        {
          "action": "click",
          "desc": "点击「确认」",
          "text": "确认",
          "pick": "last",
          "wait": 1200,
          "target": [
            "div.claim-source-dialog .weui-desktop-dialog__ft div.weui-desktop-btn_wrp button.weui-desktop-btn_primary",
            "#vue_app > mp-image-product-dialog > div.claim-source-dialog > div.weui-desktop-dialog__wrp > div > div.weui-desktop-dialog__ft > div:nth-child(1) > button"
          ]
        },
        {
          "action": "waitGone",
          "desc": "确认弹框已关闭",
          "optional": true,
          "timeout": 5000,
          "target": ["div.claim-source-dialog .weui-desktop-dialog__ft"]
        }
      ],
      "verify": {
        "action": "text",
        "value": "AI",
        "timeout": 8000,
        "target": [
          "#js_claim_source_area .js_claim_source_desc",
          "#js_claim_source_area .js_claim_source_desc span.lbl_content_desc"
        ]
      }
    }
  ]
}
